# Copy to .env and fill in. NEVER commit the real .env -- see CLAUDE.md Section 6.

# Fernet key used by backend/secrets_manager.py to encrypt stored target credentials.
# Generate a real one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRETS_KEY=replace-me-with-a-generated-fernet-key

# PostgreSQL connection (Phase 2 onward).
DATABASE_URL=postgresql://audit:replace-me@localhost:5432/audit_tool
